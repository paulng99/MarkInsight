@@ -0,0 +1,51 @@
+"use client";
+
+type Tone = "info" | "warn" | "success" | "error" | "neutral";
+
+const TONE_BY_STATUS: Record<string, Tone> = {
+  pending: "info",
+  queued: "info",
+  stored: "info",
+  running: "warn",
+  indexing: "warn",
+  stopping: "warn",
+  done: "success",
+  ready: "success",
+  succeeded: "success",
+  completed: "success",
+  failed: "error",
+  error: "error",
+  cancelled: "neutral",
+};
+
+const ACTIVE = new Set(["running", "indexing", "pending", "queued", "stopping"]);
+
+export function statusTone(status: string): Tone {
+  return TONE_BY_STATUS[status.toLowerCase()] ?? "neutral";
+}
+
+/**
+ * Semantic status pill (ported from MarkInsight's JobStatusBadge).
+ * Pulses while the underlying job is still active.
+ */
+export function StatusBadge({
+  status,
+  label,
+  pulse = false,
+  className = "",
+}: {
+  status: string;
+  label?: string;
+  pulse?: boolean;
+  className?: string;
+}) {
+  const tone = statusTone(status);
+  const active = pulse && ACTIVE.has(status.toLowerCase());
+  return (
+    <span
+      className={`badge badge-${tone}${active ? " job-pulse" : ""} ${className}`.trim()}
+    >
+      {label ?? status}
+    </span>
+  );
+}
-- 
