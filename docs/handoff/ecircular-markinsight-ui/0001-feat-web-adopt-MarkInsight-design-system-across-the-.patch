diff --git a/apps/web/src/components/LocaleSwitch.tsx b/apps/web/src/components/LocaleSwitch.tsx
new file mode 100644
index 0000000..d2a3700
--- /dev/null
+++ b/apps/web/src/components/LocaleSwitch.tsx
@@ -0,0 +1,37 @@
+"use client";
+
+import { useLocale } from "next-intl";
+import { Link, usePathname } from "@/i18n/routing";
+
+const LOCALES = [
+  { code: "zh-HK", label: "繁" },
+  { code: "en", label: "EN" },
+] as const;
+
+/** `繁 | EN` locale links that keep the current path (MarkInsight header idiom). */
+export function LocaleSwitch({ className = "" }: { className?: string }) {
+  const locale = useLocale();
+  const pathname = usePathname();
+
+  return (
+    <div className={`locale-switch ${className}`.trim()} aria-label="Language">
+      {LOCALES.map((item, index) => (
+        <span key={item.code} className="contents">
+          {index > 0 ? (
+            <span className="sep" aria-hidden>
+              |
+            </span>
+          ) : null}
+          <Link
+            href={pathname}
+            locale={item.code}
+            className={locale === item.code ? "active" : undefined}
+            aria-current={locale === item.code ? "true" : undefined}
+          >
+            {item.label}
+          </Link>
+        </span>
+      ))}
+    </div>
+  );
+}
