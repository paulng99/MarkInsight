# MarkInsight — environment placeholders (copy to `.env` / `.env.local`)
# Never commit real secrets. No production email required for the auth stub.

# --- App ---
# Public URL used by NextAuth callbacks
NEXTAUTH_URL=http://localhost:3000
# Generate a random string for local/dev (e.g. openssl rand -base64 32)
# Auth.js v5 also accepts AUTH_SECRET; either works.
NEXTAUTH_SECRET=replace-with-a-long-random-string
AUTH_SECRET=replace-with-a-long-random-string

# Default UI locale: en | zh-HK
NEXT_PUBLIC_DEFAULT_LOCALE=zh-HK

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/markinsight?schema=public

# --- Object storage (exam assets) — stub only ---
# Provider hint: s3 | r2 | local
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=

# --- LLM / multimodal analysis — stub only (no live calls in scaffold) ---
# e.g. openrouter
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=

# Optional embeddings (e.g. jina.ai) — unused in scaffold
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Optional media helpers (e.g. fal.ai) — unused in scaffold
FAL_KEY=
