# MarkInsight — environment placeholders (copy to `.env` / `.env.local`)
# Never commit real secrets. No production email required for the auth stub.
# OpenRouter / Jina API keys are env-only — never store in UI or database.

# --- App ---
# Canonical public origin for Auth.js callbacks (sign-in, /api/auth).
# Local dev: http://localhost:3000 is fine (the app ignores loopback and uses the request host).
# DigitalOcean / public IP: set this to the URL you open in the browser, or leave the localhost
# value — loopback is ignored so http://<droplet-ip>:3000 keeps working.
# Example: NEXTAUTH_URL=http://203.0.113.10:3000
# Example: NEXTAUTH_URL=https://markinsight.example.com
NEXTAUTH_URL=http://localhost:3000
# Generate a random string for local/dev (e.g. openssl rand -base64 32)
# Auth.js v5 also accepts AUTH_SECRET; either works.
NEXTAUTH_SECRET=replace-with-a-long-random-string
AUTH_SECRET=replace-with-a-long-random-string

# Default UI locale: en | zh-HK
NEXT_PUBLIC_DEFAULT_LOCALE=zh-HK

# --- Database (PostgreSQL) ---
# Local npm run dev (optional host container markinsight-db on 5434):
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/markinsight?schema=public
# docker compose up (local demo) overrides DATABASE_URL inside the web container to:
# postgresql://markinsight:markinsight@db:5432/markinsight?schema=public
#
# Production example (docker-compose.prod.example.yml) reads ALL of these from `.env`
# (nothing is hardcoded in the YAML). They MUST agree, and DATABASE_URL must use host `db`:
# POSTGRES_USER=markinsight
# POSTGRES_PASSWORD=
# POSTGRES_DB=markinsight
# DATABASE_URL=postgresql://markinsight:YOUR_PASSWORD@db:5432/markinsight?schema=public
# Public sites: set NEXTAUTH_URL / AUTH_URL to https://your-domain (teacher temp passwords
# are returned in JSON — do not serve the public site over plain HTTP).

# --- Object storage (exam assets) ---
# Provider hint: s3 | r2 | local (MVP uses local filesystem)
STORAGE_PROVIDER=local
# Local root for STORAGE_PROVIDER=local (default: .data/uploads)
STORAGE_LOCAL_DIR=
# Optional upload size cap in bytes (default: 104857600 = 100MB)
# UPLOAD_MAX_BYTES=104857600
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=

# --- OpenRouter (REQUIRED for live multimodal LLM) ---
# All exam-structure analysis + student submission scoring go through OpenRouter
# (OpenAI-compatible API). Never commit a real key. Never put this key in SchoolSettings / UI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated optional filter for SchoolSettings.analysisLlmModel.
# If empty, admin pickers load the live multimodal catalog from OPENROUTER_BASE_URL/models.
# If set, only these ids appear (still validated server-side).
# Example:
# OPENROUTER_MODEL_ALLOWLIST=qwen/qwen2.5-vl-72b-instruct,mistralai/mistral-small-3.1-24b-instruct,deepseek/deepseek-v4-pro-0813
# Note (HK): google/gemini-* and openai/gpt-* are often geo-blocked on OpenRouter from Hong Kong.
# Prefer VL models that accept PDF via OpenRouter `file` parts (not image_url).
OPENROUTER_MODEL_ALLOWLIST=
# Optional legacy/default model hints for the LLM client (must still be on the allowlist when used)
OPENROUTER_EXAM_STRUCTURE_MODEL=
OPENROUTER_SCORING_MODEL=
# Optional OpenRouter ranking / attribution headers
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=MarkInsight
# Offline verify without a live key: deterministic structure/scores (never shown as a vendor).
# When false/empty and OPENROUTER_API_KEY is missing, jobs fail with a vendor-neutral message.
#
# IMPORTANT — local laptop / docker compose DEMO:
#   Set MARKINSIGHT_ANALYSIS_DEMO=true MANUALLY if you want demo accounts to accept the
#   legacy password "password" and the login page demo hint. Default below is false so a
#   copied .env cannot accidentally enable that on a public URL.
# Production MUST leave this false or unset.
MARKINSIGHT_ANALYSIS_DEMO=false
# Optional: strong demo password (≥12 chars) for non-ANALYSIS_DEMO deploys that still want
# demo accounts. If unset and ANALYSIS_DEMO is not true, demo login is fully disabled.
# If set but empty or shorter than 12 chars, demo login is disabled (server warns).
# MARKINSIGHT_DEMO_PASSWORD=
# Per model HTTP call timeout in milliseconds (default 120000 = 120s).
# On timeout the AnalysisJob becomes FAILED (never left RUNNING).
# MARKINSIGHT_LLM_TIMEOUT_MS=120000

# --- First real admin (optional seed; never commit real values) ---
# Do NOT use an @example.com email for the first real admin on a public site.
# MARKINSIGHT_SEED_ADMIN_EMAIL=
# MARKINSIGHT_SEED_ADMIN_PASSWORD=
# MARKINSIGHT_SEED_ADMIN_NAME=
# MARKINSIGHT_SEED_TEACHER_EMAIL=
# MARKINSIGHT_SEED_TEACHER_PASSWORD=
# MARKINSIGHT_SEED_TEACHER_NAME=
# MARKINSIGHT_SEED_SCHOOL_ID=demo_school
# When SCHOOL_ID is not demo_school, optional display name (default: School):
# MARKINSIGHT_SEED_SCHOOL_NAME=
# --- Jina (OPTIONAL) — does not block scaffold or MVP acceptance ---
# May later help syllabus/PDF text extraction or embeddings.
# First-version scoring stays OpenRouter multimodal — Jina is not required.
# Never put this key in SchoolSettings / UI / DB.
JINA_API_KEY=
# JINA_EMBEDDING_MODEL=

# Optional media helpers (e.g. fal.ai) — unused in scaffold
FAL_KEY=
